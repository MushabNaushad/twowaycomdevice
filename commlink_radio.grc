  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1050, 520]
    rotation: 0
    state: enabled

# ═════════════════════════════════════════════════════════════════════════════
# FLOW CONTROL CLOCK THROTTLE
# ═════════════════════════════════════════════════════════════════════════════
- name: blocks_null_src
  id: blocks_null_source
  parameters:
    bus_structure_source: '[[0,],]'
    type: byte
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 700]
    rotation: 0
    state: enabled

- name: blocks_throttle
  id: blocks_throttle2
  parameters:
    samples_per_second: '32000'
    type: byte
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 700]
    rotation: 0
    state: enabled

- name: blocks_null_snk
  id: blocks_null_sink
  parameters:
    bus_structure_sink: '[[0,],]'
    type: byte
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 700]
    rotation: 0
    state: enabled

connections:
# Node 1
- [zmq_pull_n1, out, transport_n1, app_in]
- [transport_n1, app_out, zmq_push_n1, in]
- [transport_n1, pdu_out, rf_bus, pdu_in_1]
- [rf_bus, pdu_out_1, transport_n1, pdu_in]

# Node 2
- [zmq_pull_n2, out, transport_n2, app_in]
- [transport_n2, app_out, zmq_push_n2, in]
- [transport_n2, pdu_out, rf_bus, pdu_in_2]
- [rf_bus, pdu_out_2, transport_n2, pdu_in]

# Node 3
- [zmq_pull_n3, out, transport_n3, app_in]
- [transport_n3, app_out, zmq_push_n3, in]
- [transport_n3, pdu_out, rf_bus, pdu_in_3]
- [rf_bus, pdu_out_3, transport_n3, pdu_in]

# Node 4
- [zmq_pull_n4, out, transport_n4, app_in]
- [transport_n4, app_out, zmq_push_n4, in]
- [transport_n4, pdu_out, rf_bus, pdu_in_4]
- [rf_bus, pdu_out_4, transport_n4, pdu_in]

# Node 5
- [zmq_pull_n5, out, transport_n5, app_in]
- [transport_n5, app_out, zmq_push_n5, in]
- [transport_n5, pdu_out, rf_bus, pdu_in_5]
- [rf_bus, pdu_out_5, transport_n5, pdu_in]

# Monitor Output
- [rf_bus, mon_out, message_debug_0, print_pdu]

# Clock Throttle Loop
- [blocks_null_src, '0', blocks_throttle, '0']
- [blocks_throttle, '0', blocks_null_snk, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0

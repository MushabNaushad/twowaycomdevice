options:
  parameters:
    author: MethalMindiya
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Multi-Node ZeroMQ Radio Transport Flowgraph for Commlink GUI Application
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: commlink_radio
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '"/home/methalabeywickrama/Documents/CDP Project/twowaycomdevice/run_radio_grc.sh" {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Commlink Multi-Node Radio Transport Flowgraph (Nodes 1-5)
    window_size: (1400, 950)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 16]
    rotation: 0
    state: enabled

blocks:
- name: drop_prob
  id: variable_qtgui_range
  parameters:
    comment: Simulated RF Channel Packet Loss Rate
    gui_hint: 0,0,1,2
    label: '"RF Loss Rate (p_drop)"'
    min_len: '250'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.05'
    stop: '0.5'
    value: '0.0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 16]
    rotation: 0
    state: enabled

- name: m
  id: variable
  parameters:
    comment: Sequence space bit width (m=6 -> 64 seq, Window W=32)
    value: '6'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 16]
    rotation: 0
    state: enabled

- name: mtu
  id: variable
  parameters:
    comment: Max transmission unit (1000B payload)
    value: '1000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 16]
    rotation: 0
    state: enabled

- name: rto_ms
  id: variable
  parameters:
    comment: Retransmission timeout (400ms)
    value: '400'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 16]
    rotation: 0
    state: enabled

# ═════════════════════════════════════════════════════════════════════════════
# SHARED MULTI-NODE WIRELESS RF BROADCAST BUS
# ═════════════════════════════════════════════════════════════════════════════
- name: rf_bus
  id: epy_block
  parameters:
    _source_code: |
      import pmt, random
      from gnuradio import gr

      class multi_node_rf_bus(gr.basic_block):
          def __init__(self, drop_prob=0.0):
              gr.basic_block.__init__(self, name="Shared RF Broadcast Bus", in_sig=[], out_sig=[])
              self.drop_prob = drop_prob
              for i in range(1, 6):
                  self.message_port_register_in(pmt.intern(f"pdu_in_{i}"))
                  self.message_port_register_out(pmt.intern(f"pdu_out_{i}"))
              
              self.message_port_register_out(pmt.intern("mon_out"))

              self.set_msg_handler(pmt.intern("pdu_in_1"), self.handle_1)
              self.set_msg_handler(pmt.intern("pdu_in_2"), self.handle_2)
              self.set_msg_handler(pmt.intern("pdu_in_3"), self.handle_3)
              self.set_msg_handler(pmt.intern("pdu_in_4"), self.handle_4)
              self.set_msg_handler(pmt.intern("pdu_in_5"), self.handle_5)

          def set_drop_prob(self, p):
              self.drop_prob = p

          def _route(self, msg, src_id):
              if not pmt.is_pair(msg): return
              data = pmt.cdr(msg)
              if not pmt.is_u8vector(data): return
              raw = bytes(pmt.u8vector_elements(data))
              if len(raw) < 18: return

              types = {1:'SYN', 2:'SYN_ACK', 3:'DATA', 4:'ACK', 5:'FIN', 6:'FIN_ACK'}
              pkt_type = types.get(raw[0], f'0x{raw[0]:02X}')
              src_addr = raw[2]
              dst_addr = raw[4]
              seq = (raw[6] << 8) | raw[7]
              tot = (raw[8] << 8) | raw[9]
              sid = int.from_bytes(raw[10:18], 'big')

              if random.random() < self.drop_prob:
                  print(f"  [RF AIR DROP] Node {src_id}->{dst_addr} Type={pkt_type} Seq={seq} (DROPPED)", flush=True)
                  return

              print(f"  [RF AIR BUS] Node {src_id}->Node {dst_addr} Type={pkt_type:<7} | Seq={seq}/{tot} (Length={len(raw)}B)", flush=True)
              air_pdu = pmt.cons(pmt.make_dict(), data)

              for dst_id in range(1, 6):
                  if dst_id != src_id:
                      self.message_port_pub(pmt.intern(f"pdu_out_{dst_id}"), air_pdu)

              self.message_port_pub(pmt.intern("mon_out"), air_pdu)

          def handle_1(self, msg): self._route(msg, 1)
          def handle_2(self, msg): self._route(msg, 2)
          def handle_3(self, msg): self._route(msg, 3)
          def handle_4(self, msg): self._route(msg, 4)
          def handle_5(self, msg): self._route(msg, 5)
    comment: Shared RF broadcast medium with simulated packet loss
    drop_prob: drop_prob
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 300]
    rotation: 0
    state: enabled

# ═════════════════════════════════════════════════════════════════════════════
# NODE 1 TRANSCEIVER (local_addr=1, tx=52001, rx=52002)
# ═════════════════════════════════════════════════════════════════════════════
- name: zmq_pull_n1
  id: zeromq_pull_msg_source
  parameters:
    address: tcp://127.0.0.1:52001
    bind: 'True'
    comment: Node 1 App Input
    timeout: '100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 150]
    rotation: 0
    state: enabled

- name: transport_n1
  id: transport_transport_layer
  parameters:
    local_addr: '1'
    local_port: '0'
    comment: Transport Layer Node 1
    m: m
    mtu_bytes: mtu
    node_role: '"initiator"'
    rto_ms: rto_ms
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [260, 130]
    rotation: 0
    state: enabled

- name: zmq_push_n1
  id: zeromq_push_msg_sink
  parameters:
    address: tcp://127.0.0.1:52002
    bind: 'True'
    comment: Node 1 App Output
    timeout: '100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [260, 220]
    rotation: 180
    state: enabled


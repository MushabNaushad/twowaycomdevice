options:
  parameters:
    author: MethalMindiya
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Multi-Node ZeroMQ Radio Transport Flowgraph for Commlink GUI Application
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: commlink_radio
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '"/home/methalabeywickrama/Documents/CDP Project/twowaycomdevice/run_radio_grc.sh"
      {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Commlink Multi-Node Radio Transport Flowgraph (Nodes 1-5)
    window_size: (1400, 950)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 16]
    rotation: 0
    state: enabled

blocks:
- name: drop_prob
  id: variable_qtgui_range
  parameters:
    comment: Simulated RF Channel Packet Loss Rate
    gui_hint: 0,0,1,2
    label: '"RF Loss Rate (p_drop)"'
    min_len: '250'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.05'
    stop: '0.5'
    value: '0.0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 16]
    rotation: 0
    state: enabled
- name: m
  id: variable
  parameters:
    comment: Sequence space bit width (m=14 -> 16384 seq, Window W=8192, 16MB+ capacity)
    value: '14'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 16]
    rotation: 0
    state: enabled
- name: mtu
  id: variable
  parameters:
    comment: Max transmission unit (1000B payload)
    value: '1000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 16]
    rotation: 0
    state: enabled
- name: rto_ms
  id: variable
  parameters:
    comment: Retransmission timeout (400ms)
    value: '400'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 16]
    rotation: 0
    state: enabled
- name: blocks_null_snk
  id: blocks_null_sink
  parameters:
    affinity: ''
    alias: ''
    bus_structure_sink: '[[0,],]'
    comment: ''
    num_inputs: '1'
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 700]
    rotation: 0
    state: enabled
- name: blocks_null_src
  id: blocks_null_source
  parameters:
    affinity: ''
    alias: ''
    bus_structure_source: '[[0,],]'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_outputs: '1'
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 700]
    rotation: 0
    state: enabled
- name: blocks_throttle
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: '32000'
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 700]
    rotation: 0
    state: enabled
- name: message_debug_0
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: RF Packet Monitor & Hex Dump Console
    en_uvec: 'True'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1050, 520]
    rotation: 0
    state: enabled
- name: rf_bus
  id: epy_block
  parameters:
    _source_code: "import pmt, random\nfrom gnuradio import gr\n\nclass multi_node_rf_bus(gr.basic_block):\n\
      \    def __init__(self, drop_prob=0.0):\n        gr.basic_block.__init__(self,\
      \ name=\"Shared RF Broadcast Bus\", in_sig=[], out_sig=[])\n        self.drop_prob\
      \ = drop_prob\n        for i in range(1, 6):\n            self.message_port_register_in(pmt.intern(f\"\
      pdu_in_{i}\"))\n            self.message_port_register_out(pmt.intern(f\"pdu_out_{i}\"\
      ))\n        \n        self.message_port_register_out(pmt.intern(\"mon_out\"\
      ))\n\n        self.set_msg_handler(pmt.intern(\"pdu_in_1\"), self.handle_1)\n\
      \        self.set_msg_handler(pmt.intern(\"pdu_in_2\"), self.handle_2)\n   \
      \     self.set_msg_handler(pmt.intern(\"pdu_in_3\"), self.handle_3)\n      \
      \  self.set_msg_handler(pmt.intern(\"pdu_in_4\"), self.handle_4)\n        self.set_msg_handler(pmt.intern(\"\
      pdu_in_5\"), self.handle_5)\n\n    def set_drop_prob(self, p):\n        self.drop_prob\
      \ = p\n\n    def _route(self, msg, src_id):\n        if not pmt.is_pair(msg):\
      \ return\n        data = pmt.cdr(msg)\n        if not pmt.is_u8vector(data):\
      \ return\n        raw = bytes(pmt.u8vector_elements(data))\n        if len(raw)\
      \ < 18: return\n\n        types = {1:'SYN', 2:'SYN_ACK', 3:'DATA', 4:'ACK',\
      \ 5:'FIN', 6:'FIN_ACK'}\n        pkt_type = types.get(raw[0], f'0x{raw[0]:02X}')\n\
      \        src_addr = raw[2]\n        dst_addr = raw[4]\n        seq = (raw[6]\
      \ << 8) | raw[7]\n        tot = (raw[8] << 8) | raw[9]\n        sid = int.from_bytes(raw[10:18],\
      \ 'big')\n\n        if random.random() < self.drop_prob:\n            print(f\"\
      \  [RF AIR DROP] Node {src_id}->{dst_addr} Type={pkt_type} Seq={seq} (DROPPED)\"\
      , flush=True)\n            return\n\n        print(f\"  [RF AIR BUS] Node {src_id}->Node\
      \ {dst_addr} Type={pkt_type:<7} | Seq={seq}/{tot} (Length={len(raw)}B)\", flush=True)\n\
      \        air_pdu = pmt.cons(pmt.make_dict(), data)\n\n        for dst_id in\
      \ range(1, 6):\n            if dst_id != src_id:\n                self.message_port_pub(pmt.intern(f\"\
      pdu_out_{dst_id}\"), air_pdu)\n\n        self.message_port_pub(pmt.intern(\"\
      mon_out\"), air_pdu)\n\n    def handle_1(self, msg): self._route(msg, 1)\n \
      \   def handle_2(self, msg): self._route(msg, 2)\n    def handle_3(self, msg):\
      \ self._route(msg, 3)\n    def handle_4(self, msg): self._route(msg, 4)\n  \
      \  def handle_5(self, msg): self._route(msg, 5)\n"
    affinity: ''
    alias: ''
    comment: Shared RF broadcast medium with simulated packet loss
    drop_prob: drop_prob
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Shared RF Broadcast Bus', 'multi_node_rf_bus', [('drop_prob', '0.0')],
      [('pdu_in_3', 'message', 1), ('pdu_in_2', 'message', 1), ('pdu_in_5', 'message',
      1), ('pdu_in_4', 'message', 1), ('pdu_in_1', 'message', 1)], [('mon_out', 'message',
      1), ('pdu_out_5', 'message', 1), ('pdu_out_4', 'message', 1), ('pdu_out_3',
      'message', 1), ('pdu_out_2', 'message', 1), ('pdu_out_1', 'message', 1)], '',
      ['drop_prob'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 300]
    rotation: 0
    state: enabled

      ''byte'', 1)], [(''header_data'', ''message'', 1), (''mcs_out'', ''message'',
      1), (''len_out'', ''message'', 1)], "\n    Correlates for CCSDS 32-bit ASM (0x1ACFFC1D)
      on an unpacked bit stream.\n    Decodes MCS and Payload Length, and outputs:\n      -
      ''len_out''     : Payload byte length (connects to Unpacked Payload Decoder)\n      -
      ''mcs_out''     : 0 for BPSK, 1 for QPSK (connects to Selector o_index)\n      -
      ''header_data'' : Dict with payload_symbols (connects to Header/Payload Demux)\n    ",
      [])'

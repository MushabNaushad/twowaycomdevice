- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\nimport\
      \ zlib\nimport time\nimport random\nimport threading\nimport queue\n\nclass\
      \ MacCsmaFramerTX(gr.basic_block):\n    \"\"\"\n    Implements MAC framing,\
      \ CSMA/CA (LBT + SIFS + Exponential Backoff),\n    and frame construction [Dest\
      \ (1B) | Src (1B) | Len (2B) | Payload | CRC32 (4B)].\n    \"\"\"\n    def __init__(self,\
      \ src_id=1, default_dest_id=0xFF, sifs_gap=0.015, base_backoff=0.02, max_attempts=10):\n\
      \        gr.basic_block.__init__(\n            self,\n            name=\"MAC\
      \ CSMA Framer TX\",\n            in_sig=None,\n            out_sig=None\n  \
      \      )\n        self.src_id = int(src_id) & 0xFF\n        self.default_dest_id\
      \ = int(default_dest_id) & 0xFF\n        self.sifs_gap = float(sifs_gap)\n \
      \       self.base_backoff = float(base_backoff)\n        self.max_attempts =\
      \ int(max_attempts)\n\n        # Channel state tracking\n        self.channel_state\
      \ = \"IDLE\"  # \"IDLE\", \"RECEIVING\", \"TRANSMITTING\"\n        self.last_rx_endtime\
      \ = 0.0\n        self.state_lock = threading.Lock()\n\n        # Message Ports\n\
      \        self.message_port_register_in(pmt.intern(\"msg_in\"))\n        self.set_msg_handler(pmt.intern(\"\
      msg_in\"), self.handle_app_msg)\n\n        self.message_port_register_in(pmt.intern(\"\
      rx_status_in\"))\n        self.set_msg_handler(pmt.intern(\"rx_status_in\"),\
      \ self.handle_rx_status)\n\n        self.message_port_register_out(pmt.intern(\"\
      pdu_out\"))\n\n        # Asynchronous TX worker queue\n        self.tx_queue\
      \ = queue.Queue()\n        self.running = True\n        self.worker_thread =\
      \ threading.Thread(target=self._tx_worker, daemon=True)\n        self.worker_thread.start()\n\
      \n    def set_src_id(self, src_id):\n        self.src_id = int(src_id) & 0xFF\n\
      \n    def set_default_dest_id(self, default_dest_id):\n        self.default_dest_id\
      \ = int(default_dest_id) & 0xFF\n\n    def set_channel_state(self, new_state):\n\
      \        with self.state_lock:\n            if self.channel_state == \"RECEIVING\"\
      \ and new_state == \"IDLE\":\n                self.last_rx_endtime = time.time()\n\
      \            self.channel_state = new_state\n\n    def is_channel_free(self):\n\
      \        with self.state_lock:\n            if self.channel_state != \"IDLE\"\
      :\n                return False\n            if (time.time() - self.last_rx_endtime)\
      \ < self.sifs_gap:\n                return False\n            return True\n\n\
      \    def handle_rx_status(self, msg):\n        status_str = str(pmt.to_python(msg)).upper()\n\
      \        if \"START\" in status_str or \"BUSY\" in status_str or \"RECV\" in\
      \ status_str:\n            self.set_channel_state(\"RECEIVING\")\n        elif\
      \ \"END\" in status_str or \"IDLE\" in status_str:\n            self.set_channel_state(\"\
      IDLE\")\n\n    def handle_app_msg(self, msg):\n        dest_id = self.default_dest_id\n\
      \        payload = b\"\"\n\n        if pmt.is_pair(msg):\n            meta =\
      \ pmt.car(msg)\n            data = pmt.cdr(msg)\n            if pmt.is_dict(meta):\n\
      \                d_val = pmt.dict_ref(meta, pmt.intern(\"dest_id\"), pmt.PMT_NIL)\n\
      \                if not pmt.is_null(d_val):\n                    dest_id = pmt.to_long(d_val)\
      \ & 0xFF\n            if pmt.is_u8vector(data):\n                payload = bytes(pmt.u8vector_elements(data))\n\
      \            elif pmt.is_uniform_vector(data):\n                payload = bytes(pmt.to_python(data))\n\
      \        elif pmt.is_symbol(msg) or pmt.is_string(msg):\n            payload\
      \ = pmt.to_python(msg).encode('utf-8')\n        else:\n            py_val =\
      \ pmt.to_python(msg)\n            if isinstance(py_val, tuple) and len(py_val)\
      \ == 2 and isinstance(py_val[0], int):\n                dest_id = py_val[0]\
      \ & 0xFF\n                payload = py_val[1].encode('utf-8') if isinstance(py_val[1],\
      \ str) else bytes(py_val[1])\n            elif isinstance(py_val, str):\n  \
      \              payload = py_val.encode('utf-8')\n            elif isinstance(py_val,\
      \ (bytes, bytearray)):\n                payload = bytes(py_val)\n\n        if\
      \ not payload:\n            return\n\n        # Frame: [Dest ID (1B) | Src ID\
      \ (1B) | Length (2B) | Payload | CRC32 (4B)]\n        len_hdr = len(payload).to_bytes(2,\
      \ byteorder='big')\n        crc_hdr = zlib.crc32(payload).to_bytes(4, byteorder='big')\n\
      \        mac_frame = bytes([dest_id, self.src_id]) + len_hdr + payload + crc_hdr\n\
      \n        vec = pmt.init_u8vector(len(mac_frame), list(mac_frame))\n       \
      \ pdu = pmt.cons(pmt.PMT_NIL, vec)\n        self.tx_queue.put(pdu)\n\n    def\
      \ _tx_worker(self):\n        while self.running:\n            try:\n       \
      \         pdu = self.tx_queue.get(timeout=0.05)\n            except queue.Empty:\n\
      \                continue\n\n            # CSMA / LBT Contention Loop\n    \
      \        sent = False\n            for attempt in range(self.max_attempts):\n\
      \                if self.is_channel_free():\n                    self.set_channel_state(\"\
      TRANSMITTING\")\n                    self.message_port_pub(pmt.intern(\"pdu_out\"\
      ), pdu)\n                    time.sleep(0.010)  # Airtime / burst clearance\
      \ window\n                    self.set_channel_state(\"IDLE\")\n           \
      \         sent = True\n                    break\n\n                # Exponential\
      \ backoff on channel busy\n                cw_max = min(16, 2 ** attempt)\n\
      \                random_slots = random.randint(1, cw_max)\n                time.sleep(random_slots\
      \ * self.base_backoff)\n\n            if not sent:\n                print(f\"\
      [MAC CSMA] Dropped frame: Channel busy after {self.max_attempts} attempts\"\
      , flush=True)\n\n            self.tx_queue.task_done()\n\n    def stop(self):\n\
      \        self.running = False\n        if self.worker_thread.is_alive():\n \
      \           self.worker_thread.join(timeout=0.2)\n        return gr.basic_block.stop(self)"
    affinity: ''
    alias: ''
    base_backoff: ''
    comment: ''
    default_dest_id: '255'
    max_attempts: ''
    maxoutbuf: '0'
    minoutbuf: '0'

      '255'), ('sifs_gap', '0.015'), ('base_backoff', '0.02'), ('max_attempts', '10')],
      [('rx_status_in', 'message', 1), ('msg_in', 'message', 1)], [('pdu_out', 'message',
      1)], '\nImplements MAC framing, CSMA/CA (LBT + SIFS + Exponential Backoff),\nand
      frame construction [Dest (1B) | Src (1B) | Len (2B) | Payload | CRC32 (4B)].\n',
      ['base_backoff', 'default_dest_id', 'max_attempts', 'sifs_gap', 'src_id'])

- name: epy_block_0_0_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\n\nclass\
      \ PacketDeframerRX(gr.sync_block):\n    \"\"\"\n    PHY Deframer: Bit sync,\
      \ frame extraction, and carrier sensing status reporter.\n    \"\"\"\n    STATE_SYNC\
      \ = 0\n    STATE_MAC_HDR = 1\n    STATE_PAYLOAD_CRC = 2\n\n    def __init__(self,\
      \ max_bit_errors=1, max_payload_len=512):\n        gr.sync_block.__init__(\n\
      \            self,\n            name=\"Packet Deframer RX (PHY)\",\n       \
      \     in_sig=[np.uint8],\n            out_sig=None\n        )\n        self.max_bit_errors\
      \ = int(max_bit_errors)\n        self.max_payload_len = int(max_payload_len)\n\
      \        self.sync_target = 0x1ACFFC1D\n\n        self.state = self.STATE_SYNC\n\
      \        self.shift_reg = 0\n        self.bit_buf = 0\n        self.bit_count\
      \ = 0\n        self.byte_buf = bytearray()\n        self.payload_len = 0\n \
      \       self.target_bytes = 0\n\n        self.message_port_register_out(pmt.intern(\"\
      pdu_out\"))\n        self.message_port_register_out(pmt.intern(\"status_out\"\
      ))\n\n    def work(self, input_items, output_items):\n        in_bits = input_items[0]\n\
      \n        for bit in in_bits:\n            b = int(bit) & 1\n\n            if\
      \ self.state == self.STATE_SYNC:\n                self.shift_reg = ((self.shift_reg\
      \ << 1) | b) & 0xFFFFFFFF\n                xor_diff = self.shift_reg ^ self.sync_target\n\
      \n                if bin(xor_diff).count('1') <= self.max_bit_errors:\n    \
      \                # Sync detected: Notify CSMA MAC that channel is busy\n   \
      \                 self.message_port_pub(pmt.intern(\"status_out\"), pmt.intern(\"\
      RX_START\"))\n                    self.state = self.STATE_MAC_HDR\n        \
      \            self.bit_buf = 0\n                    self.bit_count = 0\n    \
      \                self.byte_buf = bytearray()\n                    self.target_bytes\
      \ = 4  # [Dest ID (1B), Src ID (1B), Length (2B)]\n\n            elif self.state\
      \ == self.STATE_MAC_HDR:\n                self.bit_buf = (self.bit_buf << 1)\
      \ | b\n                self.bit_count += 1\n                if self.bit_count\
      \ == 8:\n                    self.byte_buf.append(self.bit_buf)\n          \
      \          self.bit_buf = 0\n                    self.bit_count = 0\n      \
      \              if len(self.byte_buf) == self.target_bytes:\n               \
      \         self.payload_len = (self.byte_buf[2] << 8) | self.byte_buf[3]\n  \
      \                      if 0 < self.payload_len <= self.max_payload_len:\n  \
      \                          self.state = self.STATE_PAYLOAD_CRC\n           \
      \                 self.target_bytes = 4 + self.payload_len + 4  # Hdr(4) + Payload\
      \ + CRC(4)\n                        else:\n                            # Invalid\
      \ length / False trigger: Reset channel state\n                            self.message_port_pub(pmt.intern(\"\
      status_out\"), pmt.intern(\"RX_END\"))\n                            self.state\
      \ = self.STATE_SYNC\n\n            elif self.state == self.STATE_PAYLOAD_CRC:\n\
      \                self.bit_buf = (self.bit_buf << 1) | b\n                self.bit_count\
      \ += 1\n                if self.bit_count == 8:\n                    self.byte_buf.append(self.bit_buf)\n\
      \                    self.bit_buf = 0\n                    self.bit_count =\
      \ 0\n                    if len(self.byte_buf) == self.target_bytes:\n     \
      \                   pdu_vec = pmt.init_u8vector(len(self.byte_buf), list(self.byte_buf))\n\
      \                        self.message_port_pub(pmt.intern(\"pdu_out\"), pmt.cons(pmt.PMT_NIL,\
      \ pdu_vec))\n                        self.message_port_pub(pmt.intern(\"status_out\"\
      ), pmt.intern(\"RX_END\"))\n\n                        self.state = self.STATE_SYNC\n\
      \                        self.shift_reg = 0\n\n        return len(in_bits)"
    affinity: ''
    alias: ''
    comment: ''
    max_bit_errors: '1'
    max_payload_len: '4096'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''Packet Deframer RX (PHY)'', ''PacketDeframerRX'', [(''max_bit_errors'',
      ''1''), (''max_payload_len'', ''512'')], [(''0'', ''byte'', 1)], [(''status_out'',
      ''message'', 1), (''pdu_out'', ''message'', 1)], ''\nPHY Deframer: Bit sync,
      frame extraction, and carrier sensing status reporter.\n'', [''max_bit_errors'',
      ''max_payload_len''])'

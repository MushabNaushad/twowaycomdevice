- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\nimport\
      \ zlib\n\nclass MacDeframerRX(gr.basic_block):\n    def __init__(self, my_node_id=2):\n\
      \        gr.basic_block.__init__(\n            self,\n            name=\"MAC\
      \ Deframer RX\",\n            in_sig=None,\n            out_sig=None\n     \
      \   )\n        self.my_node_id = int(my_node_id) & 0xFF\n\n        self.message_port_register_in(pmt.intern(\"\
      pdu_in\"))\n        self.set_msg_handler(pmt.intern(\"pdu_in\"), self.handle_pdu)\n\
      \        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\n    def\
      \ set_my_node_id(self, my_node_id):\n        self.my_node_id = int(my_node_id)\
      \ & 0xFF\n\n    def handle_pdu(self, msg):\n        if not pmt.is_pair(msg):\n\
      \            return\n        data = pmt.cdr(msg)\n        if not pmt.is_u8vector(data):\n\
      \            return\n\n        raw_bytes = bytes(pmt.u8vector_elements(data))\n\
      \        if len(raw_bytes) < 9:\n            return\n\n        dest_id = raw_bytes[0]\n\
      \        src_id = raw_bytes[1]\n        payload_len = (raw_bytes[2] << 8) |\
      \ raw_bytes[3]\n\n        if len(raw_bytes) != (8 + payload_len):\n        \
      \    return\n\n        payload = raw_bytes[4:4 + payload_len]\n        rx_crc\
      \ = int.from_bytes(raw_bytes[4 + payload_len: 8 + payload_len], 'big')\n   \
      \     calc_crc = zlib.crc32(payload)\n\n        # 1. Check CRC\n        if rx_crc\
      \ != calc_crc:\n            print(f\"[MAC CRC ERROR] Dest: {dest_id:#04x}, Src:\
      \ {src_id:#04x} | Expected: {calc_crc:#010x}, Received: {rx_crc:#010x}\", flush=True)\n\
      \            return\n\n        # 2. Match Node Address or Broadcast (0xFF)\n\
      \        if dest_id == self.my_node_id or dest_id == 0xFF:\n            msg_str\
      \ = payload.decode('utf-8', errors='replace')\n            print(f\"\\n========================================\"\
      , flush=True)\n            print(f\"[MAC RX] Node {src_id} -> Node {dest_id}\
      \ ({payload_len} Bytes): {msg_str}\", flush=True)\n            print(f\"========================================\\\
      n\", flush=True)\n\n            meta = pmt.make_dict()\n            meta = pmt.dict_add(meta,\
      \ pmt.intern(\"src_id\"), pmt.from_long(src_id))\n            meta = pmt.dict_add(meta,\
      \ pmt.intern(\"dest_id\"), pmt.from_long(dest_id))\n            out_vec = pmt.init_u8vector(len(payload),\
      \ list(payload))\n            self.message_port_pub(pmt.intern(\"pdu_out\"),\
      \ pmt.cons(meta, out_vec))"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    my_node_id: ''
  states:
    _io_cache: ('MAC Deframer RX', 'MacDeframerRX', [('my_node_id', '2')], [('pdu_in',
      'message', 1)], [('pdu_out', 'message', 1)], '', ['my_node_id'])

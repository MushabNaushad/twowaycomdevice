- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\n\nclass\
      \ PacketFramerTX(gr.basic_block):\n    def __init__(self, preamble_len=64, postamble_len=16,\
      \ repeat_count=3):\n        gr.basic_block.__init__(\n            self,\n  \
      \          name=\"Packet Framer TX (PHY)\",\n            in_sig=None,\n    \
      \        out_sig=None\n        )\n        self.preamble_len = int(preamble_len)\n\
      \        self.postamble_len = int(postamble_len)\n        self.repeat_count\
      \ = int(repeat_count)\n        self.sync_word = bytes([0x1A, 0xCF, 0xFC, 0x1D])\n\
      \n        self.message_port_register_in(pmt.intern(\"pdu_in\"))\n        self.set_msg_handler(pmt.intern(\"\
      pdu_in\"), self.handle_pdu)\n        self.message_port_register_out(pmt.intern(\"\
      pdu_out\"))\n\n    def set_repeat_count(self, repeat_count):\n        self.repeat_count\
      \ = int(repeat_count)\n\n    def handle_pdu(self, msg):\n        if not pmt.is_pair(msg):\n\
      \            return\n        data = pmt.cdr(msg)\n        if not pmt.is_u8vector(data):\n\
      \            return\n\n        mac_payload = bytes(pmt.u8vector_elements(data))\n\
      \        if not mac_payload:\n            return\n\n        # PHY Frame: Preamble\
      \ + Sync Word + MAC Frame + Postamble\n        preamble = bytes([0xAA] * self.preamble_len)\n\
      \        postamble = bytes([0xAA] * self.postamble_len)\n        phy_frame =\
      \ preamble + self.sync_word + mac_payload + postamble\n\n        vec = pmt.init_u8vector(len(phy_frame),\
      \ list(phy_frame))\n        pdu = pmt.cons(pmt.PMT_NIL, vec)\n\n        for\
      \ _ in range(self.repeat_count):\n            self.message_port_pub(pmt.intern(\"\
      pdu_out\"), pdu)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'

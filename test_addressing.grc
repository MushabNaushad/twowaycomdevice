- name: msg_strobe
  id: blocks_message_strobe
  parameters:
    affinity: ''
    alias: ''
    comment: Sends to dst_addr=2 dst_port=1 every 4s
    maxoutbuf: '0'
    minoutbuf: '0'
    msg: pmt.cons(pmt.make_dict(), pmt.init_u8vector(25, [2, 1, 1, 0, 0, 0, 0, 17]
      + [ord(c) for c in "Hello from Node1"]))
    period: '4000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 152.0]
    rotation: 0
    state: enabled
- name: transport_decoy
  id: transport_transport_layer
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    local_addr: '3'
    local_port: '1'
    m: '4'
    maxoutbuf: '0'
    minoutbuf: '0'
    mtu_bytes: '200'
    node_role: '"responder"'
    rto_ms: '600'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 544.0]
    rotation: 0
    state: enabled
- name: transport_initiator
  id: transport_transport_layer
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    local_addr: '1'
    local_port: '1'
    m: '4'
    maxoutbuf: '0'
    minoutbuf: '0'
    mtu_bytes: '200'
    node_role: '"initiator"'
    rto_ms: '500'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [100, 250]
    rotation: 0
    state: enabled
- name: transport_responder
  id: transport_transport_layer
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    local_addr: '2'
    local_port: '1'
    m: '4'
    maxoutbuf: '0'
    minoutbuf: '0'
    mtu_bytes: '200'
    node_role: '"responder"'
    rto_ms: '500'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null

connections:
- [blocks_null_source_0, '0', blocks_throttle2_0, '0']
- [blocks_throttle2_0, '0', blocks_null_sink_0, '0']
- [channel_fwd, pdu_out, transport_decoy, pdu_in]
- [channel_fwd, pdu_out, transport_responder, pdu_in]
- [channel_rev, pdu_out, transport_initiator, pdu_in]
- [msg_strobe, strobe, transport_initiator, app_in]
- [transport_decoy, app_out, debug_decoy, print_pdu]
- [transport_decoy, pdu_out, channel_rev, pdu_in]
- [transport_initiator, app_out, debug_initiator, print_pdu]
- [transport_initiator, pdu_out, channel_fwd, pdu_in]
- [transport_responder, app_out, debug_responder, print_pdu]
- [transport_responder, pdu_out, channel_rev, pdu_in]

metadata:
  file_format: 1
  grc_version: 3.10.12.0

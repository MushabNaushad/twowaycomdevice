options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 10-node transport layer addressing test on a shared broadcast bus
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: test_10node
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 10-Node Transport Layer Addressing Test
    window_size: (1400,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:

# ── Variables / sliders ────────────────────────────────────────────────────
- name: drop_prob
  id: variable_qtgui_range
  parameters:
    comment: Shared bus drop probability (applies to ALL PDUs on the bus)
    gui_hint: 0,0,1,2
    label: '"Bus Drop Prob"'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.05'
    stop: '1'
    value: '0.1'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 8]
    rotation: 0
    state: enabled

- name: strobe_period_ms
  id: variable
  parameters:
    comment: ''
    value: '8000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [500, 8]
    rotation: 0
    state: enabled

# ── Stream keepalive (GR scheduler needs at least one stream connection) ───
- name: blocks_null_source_0
  id: blocks_null_source
  parameters:
    affinity: ''
    alias: ''
    bus_structure_source: '[[0,],]'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_outputs: '1'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 860]
    rotation: 0
    state: enabled

- name: blocks_throttle2_0
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: '1000'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 852]
    rotation: 0
    state: enabled

- name: blocks_null_sink_0
  id: blocks_null_sink
  parameters:
    affinity: ''
    alias: ''
    bus_structure_sink: '[[0,],]'
    comment: ''
    num_inputs: '1'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 860]
    rotation: 0
    state: enabled

# ── Shared bus — single lossy PDU fanout block ─────────────────────────────
# All 20 pdu_out ports fan in here; this fans out to all 20 pdu_in ports.
# The drop probability is controlled by the slider above.
- name: shared_bus
  id: epy_block
  parameters:
    _source_code: "import pmt, random\nfrom gnuradio import gr\n\nclass blk(gr.basic_block):\n\
      \    \"\"\"Shared broadcast bus with configurable loss.\n    Every PDU received\
      \  on pdu_in is forwarded to pdu_out with probability\n    (1 - p_drop). All\
      \  10 node pdu_out ports feed into pdu_in; the single\n    pdu_out is connected\
      \  to all 20 node pdu_in ports.\"\"\"\n\n    def __init__(self, p_drop=0.1):\n\
      \        gr.basic_block.__init__(\n            self,\n            name='Shared\
      \  Bus',\n            in_sig=None,\n            out_sig=None\n        )\n    \
      \    self.p_drop = p_drop\n        self.message_port_register_in(pmt.intern('pdu_in'))\n\
      \        self.message_port_register_out(pmt.intern('pdu_out'))\n        self.set_msg_handler(pmt.intern('pdu_in'),\
      \  self.handle_msg)\n\n    def handle_msg(self, msg):\n        if random.random()\
      \  >= self.p_drop:\n            self.message_port_pub(pmt.intern('pdu_out'),\
      \  msg)\n"
    affinity: ''
    alias: ''
    comment: "All node pdu_out → here → all node pdu_in\nDrop prob controlled by\
      \  slider"
    maxoutbuf: '0'
    minoutbuf: '0'
    p_drop: drop_prob
  states:
    _io_cache: "('Shared Bus', 'blk', [('p_drop', '0.1')], [('pdu_in', 'message',\
      \  1)], [('pdu_out', 'message', 1)], 'Shared broadcast bus with configurable\
      \  loss.', ['p_drop'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 420]
    rotation: 0
    state: enabled

# ── Labelled Debug EPY (reused inline for each receiver) ──────────────────
# One instance per responder node (10 total). The source code is identical;
# only the 'label' parameter differs.

- name: debug_node1
  id: epy_block
  parameters:
    _source_code: "import pmt\nfrom gnuradio import gr\n\nclass blk(gr.basic_block):\n\
      \    \"\"\"Custom labelled message sink\"\"\"\n\n    def __init__(self, label=\"\
      [MSG]\"):\n        gr.basic_block.__init__(\n            self,\n            name=\"\
      Labelled Debug\",\n            in_sig=None,\n            out_sig=None\n     \
      \   )\n        self.label = label\n        self.message_port_register_in(pmt.intern(\"\
      in\"))\n        self.set_msg_handler(pmt.intern(\"in\"), self.handle_msg)\n\n\
      \    def handle_msg(self, msg):\n        print(f\"\\n{'='*40}\")\n        print(f\"\
      \  {self.label}\")\n        print(f\"{'='*40}\")\n        if pmt.is_pair(msg):\n\
      \            meta = pmt.car(msg)\n            data = pmt.cdr(msg)\n         \
      \   print(f\"  Meta : {pmt.to_python(meta)}\")\n            if pmt.is_u8vector(data):\n\
      \                raw = bytes(pmt.u8vector_elements(data))\n                print(f\"\
      \  Bytes: {raw.hex(' ')}\")\n                try:\n                    print(f\"\
      \  ASCII: {raw[8:].decode('ascii', errors='replace')}\")\n                except:\n\
      \                    pass\n        else:\n            print(f\"  {pmt.to_python(msg)}\"\
      )\n"
    affinity: ''
    alias: ''
    comment: ''
    label: '"Node 1 RX"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Labelled Debug', 'blk', [('label', "'[MSG]'")], [('in', 'message',
      1)], [], 'Custom labelled message sink', ['label'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1100, 100]
    rotation: 0
    state: enabled


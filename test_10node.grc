# ── Message Strobes — one per initiator node ───────────────────────────────
# App bitstream header: [dst_addr, dst_port, type, 0x00, len_b3, len_b2, len_b1, len_b0, payload...]
# Byte layout: [6, 0, 1, 0, 0, 0, 0, N] + payload  →  Node 1 → Node 6, type=text, len=N bytes
# Period is staggered so sessions don't all start simultaneously (avoids S9/S10 bus congestion).

# Node 1 → Node 6  (unicast)
- name: strobe_node1
  id: blocks_message_strobe
  parameters:
    affinity: ''
    alias: ''
    comment: "Node 1 (addr=1) → Node 6 (addr=6)\ntype=text, fires every 8s"
    maxoutbuf: '0'
    minoutbuf: '0'
    msg: "pmt.cons(pmt.make_dict(), pmt.init_u8vector(8 + 19, [6, 0, 1, 0, 0, 0,\
      \  0, 19] + [ord(c) for c in \"Hello from Node 1!\"]))"
    period: strobe_period_ms
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 100]
    rotation: 0
    state: enabled

# Node 2 → Node 7  (unicast)

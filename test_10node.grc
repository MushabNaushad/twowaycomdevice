# ═══════════════════════════════════════════════════════════════════════════
connections:

# Stream keepalive
- [blocks_null_source_0, '0', blocks_throttle2_0, '0']
- [blocks_throttle2_0, '0', blocks_null_sink_0, '0']

# ── Strobes → Initiator app_in ────────────────────────────────────────────
- [strobe_node1,  strobe, ini_node1,  app_in]
- [strobe_node2,  strobe, ini_node2,  app_in]
- [strobe_node3,  strobe, ini_node3,  app_in]
- [strobe_node4,  strobe, ini_node4,  app_in]
- [strobe_node5,  strobe, ini_node5,  app_in]
- [strobe_node6,  strobe, ini_node6,  app_in]
- [strobe_node7,  strobe, ini_node7,  app_in]
- [strobe_node8,  strobe, ini_node8,  app_in]
- [strobe_node9,  strobe, ini_node9,  app_in]
- [strobe_node10, strobe, ini_node10, app_in]

# ── Initiator pdu_out → Shared Bus ───────────────────────────────────────
- [ini_node1,  pdu_out, shared_bus, pdu_in]
- [ini_node2,  pdu_out, shared_bus, pdu_in]
- [ini_node3,  pdu_out, shared_bus, pdu_in]
- [ini_node4,  pdu_out, shared_bus, pdu_in]
- [ini_node5,  pdu_out, shared_bus, pdu_in]
- [ini_node6,  pdu_out, shared_bus, pdu_in]
- [ini_node7,  pdu_out, shared_bus, pdu_in]
- [ini_node8,  pdu_out, shared_bus, pdu_in]
- [ini_node9,  pdu_out, shared_bus, pdu_in]
- [ini_node10, pdu_out, shared_bus, pdu_in]

# ── Responder pdu_out → Shared Bus (ACKs/SYN_ACKs/FIN_ACKs) ─────────────
- [rsp_node1,  pdu_out, shared_bus, pdu_in]
- [rsp_node2,  pdu_out, shared_bus, pdu_in]
- [rsp_node3,  pdu_out, shared_bus, pdu_in]
- [rsp_node4,  pdu_out, shared_bus, pdu_in]

options:
  parameters:
    author: maduwage
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: crctest
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: CRC test
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: flag
  id: variable
  parameters:
    comment: ''
    value: '126'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 16.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: DLC_CRCCheck_0
  id: DLC_CRCCheck
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    scheme: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 280.0]
    rotation: 180
    state: enabled
- name: DLC_CRCGen_0
  id: DLC_CRCGen
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    scheme: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [592, 168.0]
    rotation: 0
    state: enabled
- name: DLC_addFlags_0
  id: DLC_addFlags
  parameters:
    affinity: ''
    alias: ''
    bothEnds: 'True'
    comment: ''
    flag: flag
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [920, 160.0]
    rotation: 0
    state: enabled
- name: DLC_bitStuffing_0
  id: DLC_bitStuffing
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    flag: '126'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [752, 168.0]
    rotation: 0
    state: enabled
- name: DLC_deStuffing_0
  id: DLC_deStuffing
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    flag: '126'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [952, 280.0]
    rotation: 180
    state: enabled
- name: DLC_removeFlags_0
  id: DLC_removeFlags
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    flag: flag
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1168, 280.0]
    rotation: 180
    state: enabled
- name: blocks_message_debug_0_0
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    en_uvec: 'True'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 432.0]
    rotation: 0
    state: enabled
- name: blocks_message_debug_0_0_0
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    en_uvec: 'True'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 416.0]
    rotation: 0
    state: enabled
- name: blocks_message_debug_0_0_0_0
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    en_uvec: 'True'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [624, 16.0]
    rotation: 0
    state: enabled
- name: blocks_message_strobe_0
  id: blocks_message_strobe
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    msg: pmt.intern("TEST")
    period: '10000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [104, 160.0]
    rotation: 0
    state: enabled
- name: pdu_pdu_to_tagged_stream_0
  id: pdu_pdu_to_tagged_stream
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    tag: packet_len
    type: byte
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1136, 168.0]
    rotation: 0
    state: enabled
- name: pdu_random_pdu_0
  id: pdu_random_pdu
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    length_modulo: '1'
    mask: '0xFF'
    maxoutbuf: '0'
    maxsize: '2'
    minoutbuf: '0'
    minsize: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 144.0]
    rotation: 0
    state: enabled

connections:
- [DLC_CRCCheck_0, out, blocks_message_debug_0_0_0, print]
- [DLC_CRCGen_0, out, DLC_bitStuffing_0, in]
- [DLC_addFlags_0, out, pdu_pdu_to_tagged_stream_0, pdus]
- [DLC_bitStuffing_0, out, DLC_addFlags_0, in]
- [DLC_deStuffing_0, out, DLC_CRCCheck_0, in]
- [DLC_deStuffing_0, out, blocks_message_debug_0_0, print]
- [DLC_removeFlags_0, pdu_out, DLC_deStuffing_0, in]
- [blocks_message_strobe_0, strobe, pdu_random_pdu_0, generate]
- [pdu_pdu_to_tagged_stream_0, '0', DLC_removeFlags_0, '0']
- [pdu_random_pdu_0, pdus, DLC_CRCGen_0, in]
- [pdu_random_pdu_0, pdus, blocks_message_debug_0_0_0_0, print]

metadata:
  file_format: 1
  grc_version: 3.10.12.0

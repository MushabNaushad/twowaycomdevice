    alias: ''
    bothEnds: 'True'
    comment: ''
    flag: flag
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1160, 168.0]
    rotation: 0
    state: disabled
- name: DLC_bitStuffing_0
  id: DLC_bitStuffing
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    flag: '126'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null

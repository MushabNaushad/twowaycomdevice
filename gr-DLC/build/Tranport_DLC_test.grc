    state: enabled
- name: blocks_message_debug_0_1_0
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    en_uvec: 'True'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 512.0]
    rotation: 0
    state: enabled
- name: blocks_message_strobe_0
  id: blocks_message_strobe
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    msg: pmt.cons(pmt.make_dict(), pmt.init_u8vector(25, [171, 205, 1, 0, 0, 0, 0,
      17] + [ord(c) for c in "Hello from Strobe"]))
    period: '2000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 200.0]
    rotation: 0
    state: enabled
- name: transport_transport_layer_0
  id: transport_transport_layer
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    m: '4'
    maxoutbuf: '0'
    minoutbuf: '0'
    mtu_bytes: '200'
    node_role: '"initiator"'
    rto_ms: '500'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [344, 168.0]
    rotation: 0
    state: enabled
- name: transport_transport_layer_0_0
  id: transport_transport_layer
  parameters:

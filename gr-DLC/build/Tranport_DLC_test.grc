- name: DLC_deStuffing_0
  id: DLC_deStuffing
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    flag: '126'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [968, 376.0]
    rotation: 180
    state: disabled
- name: DLC_removeFlags_0
  id: DLC_removeFlags
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    flag: flag
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1144, 376.0]

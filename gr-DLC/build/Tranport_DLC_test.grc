    alias: ''
    comment: ''
    m: '4'
    maxoutbuf: '0'
    minoutbuf: '0'
    mtu_bytes: '200'
    node_role: '"initiator"'
    rto_ms: '500'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 376.0]
    rotation: 180
    state: enabled

connections:
- [DLC_CRCCheck_0, out, transport_transport_layer_0_0, pdu_in]
- [DLC_CRCGen_0, out, DLC_bitStuffing_0, in]
- [DLC_addFlags_0, out, DLC_removeFlags_0, pdu_in]
- [DLC_bitStuffing_0, out, DLC_addFlags_0, in]
- [DLC_deStuffing_0, out, DLC_CRCCheck_0, in]
- [DLC_removeFlags_0, pdu_out, DLC_deStuffing_0, in]
- [blocks_message_strobe_0, strobe, transport_transport_layer_0, app_in]
- [transport_transport_layer_0, app_out, blocks_message_debug_0_1, print_pdu]
- [transport_transport_layer_0, pdu_out, DLC_CRCGen_0, in]
- [transport_transport_layer_0, pdu_out, transport_transport_layer_0_0, pdu_in]
- [transport_transport_layer_0_0, app_out, blocks_message_debug_0_1_0, print_pdu]
- [transport_transport_layer_0_0, pdu_out, transport_transport_layer_0, pdu_in]

metadata:
  file_format: 1
  grc_version: 3.10.12.0

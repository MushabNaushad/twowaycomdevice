- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport sys\n\nclass\
      \ blk(gr.sync_block):\n    \"\"\"Prints incoming byte stream as ASCII text to\
      \ the GRC console\"\"\"\n\n    def __init__(self):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='Print Text to Console',\n            in_sig=[np.byte],\n\
      \            out_sig=None\n        )\n\n    def work(self, input_items, output_items):\n\
      \        in0 = input_items[0]\n        if len(in0) > 0:\n            # Filter\
      \ for printable ASCII characters and convert\n            text = \"\".join([chr(c)\
      \ for c in in0 if 32 <= c <= 126])\n            if text:\n                print(text,\
      \ end='', flush=True)\n        return len(in0)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Print Text to Console', 'blk', [], [('0', 'byte', 1)], [], 'Prints
      incoming byte stream as ASCII text to the GRC console', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 608.0]
    rotation: 180
    state: enabled

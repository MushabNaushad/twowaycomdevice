- name: app_image_generator
  id: epy_block
  parameters:
    _source_code: "import pmt, ctypes, os\nfrom gnuradio import gr\n\ntry:\n    so\
      \ = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', 'blocks',\
      \ 'gr-transport', 'build', 'lib', 'libgnuradio-transport.so'))\n    if os.path.exists(so):\n\
      \        ctypes.CDLL(so, mode=ctypes.RTLD_GLOBAL)\nexcept Exception:\n    pass\n\
      \nclass blk(gr.basic_block):\n    \"\"\"Generates a multi-chunk Image bitstream\
      \ with the 8-byte application header.\"\"\"\n    def __init__(self, dst_addr=9,\
      \ payload_len=1024):\n        gr.basic_block.__init__(self, name='App Image\
      \ Gen', in_sig=None, out_sig=None)\n        self.dst_addr = dst_addr\n    \
      \    self.payload_len = payload_len\n        self.seq_num = 0\n        self.message_port_register_in(pmt.intern('trig'))\n\
      \        self.message_port_register_out(pmt.intern('app_out'))\n        self.set_msg_handler(pmt.intern('trig'),\
      \ self.handle_trig)\n\n    def handle_trig(self, msg):\n        self.seq_num\
      \ += 1\n        img_data = bytes([(i + self.seq_num) % 256 for i in range(self.payload_len)])\n\
      \        n = len(img_data)\n        # 8-Byte Application Header: [dst_addr,\
      \ port, type=0x02(image), rsv=0, len_u32]\n        hdr = bytes([self.dst_addr,\
      \ 0x00, 0x02, 0x00, (n >> 24) & 0xFF, (n >> 16) & 0xFF, (n >> 8) & 0xFF, n &\
      \ 0xFF])\n        full_frame = list(hdr + img_data)\n        pdu = pmt.cons(pmt.make_dict(),\
      \ pmt.init_u8vector(len(full_frame), full_frame))\n        print(f\"\\n[APP\
      \ TX] Injecting Image Stream #{self.seq_num} ({len(full_frame)}B) to Node {self.dst_addr}\"\
      , flush=True)\n        self.message_port_pub(pmt.intern('app_out'), pdu)\n"
    affinity: ''
    alias: ''
    comment: Constructs 8-byte app header + image bytes
    dst_addr: dst_addr
    maxoutbuf: '0'
    minoutbuf: '0'
    payload_len: '1024'
  states:
    _io_cache: ('App Image Gen', 'blk', [('dst_addr', '9'), ('payload_len', '1024')],
      [('trig', 'message', 1)], [('app_out', 'message', 1)], 'Generates a multi-chunk
      Image bitstream with the 8-byte application header.', ['dst_addr', 'payload_len'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 180]
    rotation: 0
    state: enabled

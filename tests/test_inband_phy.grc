- name: pure_rf_channel_fwd
  id: epy_block
  parameters:
    _source_code: "import pmt, random\nfrom gnuradio import gr\n\nclass blk(gr.basic_block):\n\
      \    \"\"\"Pure-RF Physical Channel: Strips PMT metadata dict to test 100% in-band\
      \ transport.\"\"\"\n    def __init__(self, p_drop=0.0):\n        gr.basic_block.__init__(self,\
      \ name='Pure RF Channel (FWD)', in_sig=None, out_sig=None)\n        self.p_drop\
      \ = p_drop\n        self.message_port_register_in(pmt.intern('pdu_in'))\n  \
      \      self.message_port_register_out(pmt.intern('pdu_out'))\n        self.set_msg_handler(pmt.intern('pdu_in'),\
      \ self.handle_msg)\n\n    def set_p_drop(self, p):\n        self.p_drop = p\n\
      \n    def handle_msg(self, msg):\n        if not pmt.is_pair(msg):\n       \
      \     return\n        data = pmt.cdr(msg)\n        if not pmt.is_u8vector(data):\n\
      \            return\n        raw = bytes(pmt.u8vector_elements(data))\n    \
      \    if len(raw) < 18:\n            return\n        types = {1:'SYN', 2:'SYN_ACK',\
      \ 3:'DATA', 4:'ACK', 5:'FIN', 6:'FIN_ACK'}\n        pkt_type = types.get(raw[0],\
      \ f'0x{raw[0]:02X}')\n        seq = (raw[6] << 8) | raw[7]\n        tot = (raw[8]\
      \ << 8) | raw[9]\n        sid = int.from_bytes(raw[10:18], 'big')\n        \n\
      \        if random.random() < self.p_drop:\n            print(f\"  [PHY DROP\
      \ FWD] Type={pkt_type:<7} Length={len(raw):>4}B | Seq={seq} (LOST)\", flush=True)\n\
      \            return\n        \n        print(f\"  [PHY TX->RX]   Type={pkt_type:<7}\
      \ Length={len(raw):>4}B | Src={raw[2]} Dst={raw[4]} Seq={seq} Tot={tot} Sid=0x{sid:08X}\"\
      , flush=True)\n        # Wipe metadata dictionary -> pure RF byte reception\n\
      \        air_pdu = pmt.cons(pmt.make_dict(), data)\n        self.message_port_pub(pmt.intern('pdu_out'),\
      \ air_pdu)\n"
    affinity: ''
    alias: ''
    comment: Simulates over-the-air raw byte channel (0% PMT metadata)
    maxoutbuf: '0'
    minoutbuf: '0'
    p_drop: drop_prob
  states:
    _io_cache: '(''Pure RF Channel (FWD)'', ''blk'', [(''p_drop'', ''0.0'')], [(''pdu_in'',
      ''message'', 1)], [(''pdu_out'', ''message'', 1)], ''Pure-RF Physical Channel:
      Strips PMT metadata dict to test 100% in-band transport.'', [''p_drop''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [780, 180]
    rotation: 0
    state: enabled
- name: pure_rf_channel_rev
  id: epy_block
  parameters:
    _source_code: "import pmt, random\nfrom gnuradio import gr\n\nclass blk(gr.basic_block):\n\
      \    \"\"\"Pure-RF Physical Channel: Strips PMT metadata dict to test 100% in-band\
      \ transport.\"\"\"\n    def __init__(self, p_drop=0.0):\n        gr.basic_block.__init__(self,\
      \ name='Pure RF Channel (REV)', in_sig=None, out_sig=None)\n        self.p_drop\
      \ = p_drop\n        self.message_port_register_in(pmt.intern('pdu_in'))\n  \
      \      self.message_port_register_out(pmt.intern('pdu_out'))\n        self.set_msg_handler(pmt.intern('pdu_in'),\
      \ self.handle_msg)\n\n    def set_p_drop(self, p):\n        self.p_drop = p\n\
      \n    def handle_msg(self, msg):\n        if not pmt.is_pair(msg):\n       \
      \     return\n        data = pmt.cdr(msg)\n        if not pmt.is_u8vector(data):\n\
      \            return\n        raw = bytes(pmt.u8vector_elements(data))\n    \
      \    if len(raw) < 18:\n            return\n        types = {1:'SYN', 2:'SYN_ACK',\
      \ 3:'DATA', 4:'ACK', 5:'FIN', 6:'FIN_ACK'}\n        pkt_type = types.get(raw[0],\
      \ f'0x{raw[0]:02X}')\n        seq = (raw[6] << 8) | raw[7]\n        \n     \
      \   if random.random() < self.p_drop:\n            print(f\"  [PHY DROP REV]\
      \ Type={pkt_type:<7} Length={len(raw):>4}B | Seq={seq} (LOST)\", flush=True)\n\
      \            return\n        \n        print(f\"  [PHY RX->TX]   Type={pkt_type:<7}\
      \ Length={len(raw):>4}B | Seq={seq}\", flush=True)\n        air_pdu = pmt.cons(pmt.make_dict(),\
      \ data)\n        self.message_port_pub(pmt.intern('pdu_out'), air_pdu)\n"
    affinity: ''
    alias: ''
    comment: Reverse channel for ACKs and SYN_ACKs
    maxoutbuf: '0'
    minoutbuf: '0'
    p_drop: drop_prob
  states:
    _io_cache: '(''Pure RF Channel (REV)'', ''blk'', [(''p_drop'', ''0.0'')], [(''pdu_in'',
      ''message'', 1)], [(''pdu_out'', ''message'', 1)], ''Pure-RF Physical Channel:
      Strips PMT metadata dict to test 100% in-band transport.'', [''p_drop''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [912, 380.0]
    rotation: 180
    state: enabled

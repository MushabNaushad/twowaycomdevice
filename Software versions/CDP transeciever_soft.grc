    bus_source: false
    bus_structure: null
    coordinate: [488, 8.0]
    rotation: 0
    state: disabled
- name: rcc_taps
  id: variable_rrc_filter_taps
  parameters:
    alpha: alpha
    comment: ''
    gain: '1'
    ntaps: nfilts*sps
    samp_rate: samp_rate
    sym_rate: samp_rate/float(sps)
    value: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 296.0]
    rotation: 0
    state: enabled

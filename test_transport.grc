options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: test_transport
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Transport Layer Test
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: blocks_message_debug_0
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    en_uvec: 'True'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [900, 200]
    rotation: 0
    state: enabled
- name: blocks_message_strobe_0
  id: blocks_message_strobe
  parameters:
    msg: pmt.cons(pmt.make_dict(), pmt.init_u8vector(25, [2, 1, 1, 0, 0, 0, 0, 17] + [ord(c) for c in "Hello from Strobe"]))
    period: '2000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [50, 220]
    rotation: 0
    state: enabled
- name: blocks_null_sink_0
  id: blocks_null_sink
  parameters:
    affinity: ''
    alias: ''
    bus_structure_sink: '[[0,],]'
    comment: ''
    num_inputs: '1'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 400]
    rotation: 0
    state: enabled
- name: blocks_null_source_0
  id: blocks_null_source
  parameters:
    affinity: ''
    alias: ''
    bus_structure_source: '[[0,],]'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_outputs: '1'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 400]
    rotation: 0
    state: enabled
- name: blocks_throttle2_0
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: '1000'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 400]
    rotation: 0
    state: enabled
- name: transport_transport_layer_0
  id: transport_transport_layer
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    m: '4'
    maxoutbuf: '0'
    minoutbuf: '0'
    mtu_bytes: '200'
    node_role: '"initiator"'
    rto_ms: '500'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 192.0]
    rotation: 0
    state: enabled
- name: transport_transport_layer_1
  id: transport_transport_layer
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    m: '4'
    maxoutbuf: '0'
    minoutbuf: '0'
    mtu_bytes: '200'
    node_role: '"responder"'
    rto_ms: '500'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [592, 208.0]
    rotation: 0
    state: enabled

connections:
- [blocks_message_strobe_0, strobe, transport_transport_layer_0, app_in]
- [blocks_null_source_0, '0', blocks_throttle2_0, '0']
- [blocks_throttle2_0, '0', blocks_null_sink_0, '0']
- [transport_transport_layer_0, app_out, blocks_message_debug_0, print_pdu]
- [transport_transport_layer_0, pdu_out, transport_transport_layer_1, pdu_in]
- [transport_transport_layer_1, app_out, blocks_message_debug_0, print_pdu]
- [transport_transport_layer_1, pdu_out, transport_transport_layer_0, pdu_in]

metadata:
  file_format: 1
  grc_version: 3.10.12.0
